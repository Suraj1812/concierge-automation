{
  "name": "ai-concierge-system",
  "version": "1.0.0",
  "description": "Production-grade AI concierge system for WhatsApp-driven luxury service automation.",
  "private": true,
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs src/server",
    "dev:worker": "node scripts/dev-runner.mjs src/worker",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "seed:test-whatsapp": "npm run build && node dist/src/scripts/seed-test-whatsapp.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:connectors": "npm run build && node dist/tests/connectors.integration.js",
    "test:smoke": "npm run build && node dist/tests/e2e-smoke.js",
    "test:hardening": "npm run build && node dist/tests/hardening.integration.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.1",
    "mongoose": "^8.7.1",
    "nodemailer": "^6.9.15",
    "openai": "^4.76.0",
    "pdfkit": "^0.15.0",
    "razorpay": "^2.9.6",
    "uuid": "^11.0.3",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.7",
    "@types/uuid": "^10.0.0",
    "mongodb-memory-server": "^11.0.1",
    "typescript": "^5.7.2"
  }
}
